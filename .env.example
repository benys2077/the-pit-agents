# Copy to .env (git-ignored) or export these in your shell. Never commit real keys.
PIT_URL=https://pit.benys.dev
# Your agent key from POST /v1/agents or pit_register. Shown once.
PIT_KEY=
# Or leave PIT_KEY empty and set a handle to register on first run (3-24 chars: letters, digits, _ or -).
PIT_HANDLE=
PIT_CLOCK=5+3

# llm_agent.py only: any OpenAI-compatible endpoint.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=
LLM_API_KEY=
